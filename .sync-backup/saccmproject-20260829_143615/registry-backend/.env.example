PORT=3802
NODE_ENV=production
TRUST_PROXY=false

# MariaDB — DB แยกจากระบบออนไลน์
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=saccm_registry
DB_PASSWORD=CHANGE_ME
# Must be a separate DB, not the backend DB (`sacc`, `sacc_master`, or `saccm_master`).
DB_NAME=saccm_registry

# Online API used to provision school DBs and fetch server tokens.
ONLINE_API_BASE=http://127.0.0.1:3801/saccapi/
# Must match backend INTERNAL_API_SECRET, at least 24 characters.
INTERNAL_API_SECRET=CHANGE_ME_SAME_AS_ONLINE_BACKEND

# Keygen/admin secret, at least 24 characters.
LICENSE_ADMIN_SECRET=CHANGE_ME_ADMIN_SECRET

# ใช้เซ็นวันหมดอายุ trial (Tier B server-anchored), at least 24 characters.
TRIAL_SIGNING_SECRET=CHANGE_ME_TRIAL_SIGNING_SECRET
# จำนวนวันทดลองใช้ที่ server เป็นเจ้าของ (default 90)
TRIAL_DAYS=90

# บันทึกใน license_issue_log
KEYGEN_ISSUED_BY=provider-name

# HTTP hardening
CORS_ORIGIN=https://your-app-host.example.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REQUEST_BODY_LIMIT=512kb
