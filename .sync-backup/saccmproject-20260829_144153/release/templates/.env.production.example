PORT=3801
NODE_ENV=production
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=saccm_app
DB_PASSWORD=CHANGE_ME
DB_NAME=saccm_master

# JWT - must be unique random text, at least 32 characters.
SECRETKEY=CHANGE_ME_LONG_RANDOM
ALLOW_DEFAULT_CREDENTIALS=false

# Registry provisioning secret - must match registry-backend/.env, at least 24 characters.
INTERNAL_API_SECRET=CHANGE_ME_INTERNAL_SECRET

# Setup API is disabled in production by default.
ENABLE_SETUP_ROUTES=false
# Required only if ENABLE_SETUP_ROUTES=true, at least 24 characters.
SETUP_API_SECRET=CHANGE_ME_ONLY_IF_SETUP_ENABLED

# HTTP hardening
CORS_ORIGIN=https://your-app-host.example.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
REQUEST_BODY_LIMIT=1mb
